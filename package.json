{
  "name": "line-running-community-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e/webhook-to-reply.test.ts",
    "test:watch": "vitest",
    "types:bindings": "wrangler types worker-configuration.d.ts --env-interface WorkerEnv",
    "types:bindings:check": "wrangler types worker-configuration.d.ts --env-interface WorkerEnv --check",
    "typecheck": "npm run types:bindings:check && tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.12.30"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
